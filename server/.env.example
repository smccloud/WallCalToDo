# Copy to .env and fill in. Never commit the real .env file.

PORT=3000

# How often the backend polls Google/Microsoft for changes (ms).
# Polls use delta/sync tokens, so most polls cost one cheap "anything new?"
# request rather than re-fetching everything.
POLL_INTERVAL_MS=60000

# Comma-separated list of networks allowed to connect an account (the
# companion app's "Add Google account" / "Connect Microsoft account" buttons
# and the Microsoft reconnect) from somewhere other than the Pi's own screen.
# Leave it blank -- the default -- for that to stay the Pi's own screen only.
#
# Entries are IP addresses or CIDR ranges, IPv4 or IPv6, and the Pi's own
# loopback is always allowed without being listed. e.g. the whole home
# network, or just one laptop:
#   TRUSTED_CIDRS=192.168.1.0/24
#   TRUSTED_CIDRS=192.168.1.42,10.0.0.0/8,fd00::/8
#
# Every other part of the companion app is still open to your home network
# either way; this only covers the one flow that mints a token for an account.
# A remote computer also still has to get the provider's redirect back to the
# Pi (an SSH port forward does that with no other changes) -- see the
# "Connecting an account from a remote computer" section of the README.
# Restart the backend after editing this.
TRUSTED_CIDRS=

# Per-poll tally of what the Microsoft calendar poll dropped (cancelled,
# drafts, declined invites, pruned, untitled) written to journalctl as
# "[ms-calendar] round: ...". Off by default -- a busy week of declined
# invites shouldn't write a line every minute. Set to 1 and restart when the
# wall looks like it's missing events and you want to see why.
LOG_MS_CALENDAR_ROUNDS=0

# GOOGLE_CLIENT_ID/SECRET and MS_CLIENT_ID/SECRET are no longer entered
# here -- the companion app has its own forms: Google lets you save as many
# *credential sets* as you like (one per Google OAuth app; each connected
# account is tied to the set it was connected with), and Microsoft has a
# single form. Whatever's saved there takes priority over these. Left here
# only as an optional fallback for anyone who prefers a file over a web form
# -- the Google pair appears in the companion app as a read-only "server/.env"
# credential set.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback

MS_CLIENT_ID=
MS_CLIENT_SECRET=
# Optional: which Entra directory sign-in is pointed at. Leave as "common"
# (any Microsoft account -- what a personal account needs) unless you want
# sign-ins limited to your own organization's directory, in which case use
# its Directory (tenant) ID. Can also be set from the companion app's
# Microsoft section, which takes priority over whatever's here.
MS_TENANT_ID=common
MS_REDIRECT_URI=http://localhost:3000/auth/microsoft/callback
# Which To Do list(s) sync is chosen in the companion app after connecting,
# not here — every list on the account (including ones shared with you) is
# discovered automatically and can be toggled on/off individually.
